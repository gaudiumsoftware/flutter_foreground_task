<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:paddingStart="0dp"
  android:paddingEnd="16dp"
  android:paddingTop="4dp"
  android:paddingBottom="12dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:id="@+id/fft_notification_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
        android:textSize="22sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end" />

      <TextView
        android:id="@+id/fft_notification_emphasis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
        android:textSize="24sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">

        <ImageView
          android:id="@+id/fft_notification_text_icon"
          android:layout_width="15dp"
          android:layout_height="15dp"
          android:layout_marginEnd="6dp"
          android:layout_marginTop="3dp"
          android:scaleType="fitCenter"
          android:contentDescription="@null" />

        <TextView
          android:id="@+id/fft_notification_text"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textAppearance="@style/TextAppearance.Compat.Notification"
          android:textSize="14sp"
          android:maxLines="2"
          android:ellipsize="end" />
      </LinearLayout>
    </LinearLayout>

    <ImageView
      android:id="@+id/fft_notification_photo"
      android:layout_width="52dp"
      android:layout_height="52dp"
      android:layout_marginStart="12dp"
      android:scaleType="fitCenter"
      android:adjustViewBounds="true"
      android:contentDescription="@null" />
  </LinearLayout>

  <ImageView
    android:id="@+id/fft_notification_track"
    android:layout_width="match_parent"
    android:layout_height="34dp"
    android:layout_marginTop="10dp"
    android:scaleType="fitXY"
    android:contentDescription="@null" />
</LinearLayout>